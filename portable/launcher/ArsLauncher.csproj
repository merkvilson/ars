<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ARS</AssemblyName>
    <RootNamespace>ArsLauncher</RootNamespace>
    <ApplicationIcon>..\..\res\icon.ico</ApplicationIcon>
    <Description>Airen Studio Launcher</Description>
    <Copyright>Copyright © 2025 Airen Studio</Copyright>
    <Product>Airen Studio</Product>
    <Version>0.5.2</Version>
  </PropertyGroup>

  <!-- Keep Release builds clean for distribution: no PDBs, no SourceLink/repo metadata. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
